rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function member(fid){return signedIn() && exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid));}
  function owner(fid){return signedIn() && get(/databases/$(database)/documents/families/$(fid)).data.ownerUid == request.auth.uid;}
  match /families/{fid} {
   allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
   allow get: if signedIn();
   allow list: if false;
   allow update, delete: if owner(fid);
   match /members/{uid} {
    allow get, list: if member(fid) || (signedIn() && owner(fid));
    allow create: if signedIn() && uid == request.auth.uid && owner(fid);
    allow update, delete: if owner(fid);
   }
   match /requests/{uid} {
    allow create: if signedIn() && uid == request.auth.uid && !member(fid);
    allow get, list: if owner(fid) || (signedIn() && uid == request.auth.uid);
    allow delete: if owner(fid);
    allow update: if false;
   }
   match /data/{doc} {
    allow read, write: if member(fid);
   }
  }
 }
}